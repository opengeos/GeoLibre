{
  "name": "buffer-dissolve-overlapping",
  "tool": "buffer",
  "description": "Dissolve merges overlapping buffers into one attribute-less polygon; the two engines share the count, the type, and the empty properties, but not the planar-vs-UTM geometry.",
  "input": {
    "type": "FeatureCollection",
    "features": [
      {
        "type": "Feature",
        "properties": {
          "name": "Raleigh",
          "pop": 480
        },
        "geometry": {
          "type": "Point",
          "coordinates": [-78.0, 35.0]
        }
      },
      {
        "type": "Feature",
        "properties": {
          "name": "Cary",
          "pop": 180
        },
        "geometry": {
          "type": "Point",
          "coordinates": [-77.97, 35.0]
        }
      }
    ]
  },
  "parameters": {
    "distance": 5,
    "units": "kilometers",
    "dissolve": true
  },
  "expect": {
    "featureCount": 1,
    "geometryTypes": ["Polygon"],
    "properties": [{}]
  }
}
