{
  "name": "buffer-polygon-inside",
  "tool": "buffer",
  "description": "side=inside shrinks the polygon; Turf is planar and GeoPandas reprojects to UTM, so only count and geometry type are shared.",
  "input": {
    "type": "FeatureCollection",
    "features": [
      {
        "type": "Feature",
        "properties": {
          "name": "block",
          "region": "east"
        },
        "geometry": {
          "type": "Polygon",
          "coordinates": [
            [
              [-78.5, 34.5],
              [-77.5, 34.5],
              [-77.5, 35.5],
              [-78.5, 35.5],
              [-78.5, 34.5]
            ]
          ]
        }
      }
    ]
  },
  "parameters": {
    "distance": 10,
    "units": "kilometers",
    "side": "inside"
  },
  "expect": {
    "featureCount": 1,
    "geometryTypes": ["Polygon"]
  }
}
