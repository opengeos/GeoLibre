{
  "name": "buffer-polygon-both",
  "tool": "buffer",
  "description": "side=both keeps the band across the boundary, so the output polygon has an outer ring plus a hole.",
  "input": {
    "type": "FeatureCollection",
    "features": [
      {
        "type": "Feature",
        "properties": {
          "name": "block",
          "region": "east"
        },
        "geometry": {
          "type": "Polygon",
          "coordinates": [
            [
              [-78.5, 34.5],
              [-77.5, 34.5],
              [-77.5, 35.5],
              [-78.5, 35.5],
              [-78.5, 34.5]
            ]
          ]
        }
      }
    ]
  },
  "parameters": {
    "distance": 10,
    "units": "kilometers",
    "side": "both"
  },
  "expect": {
    "featureCount": 1,
    "geometryTypes": ["Polygon"],
    "properties": [
      {
        "name": "block",
        "region": "east"
      }
    ]
  }
}
