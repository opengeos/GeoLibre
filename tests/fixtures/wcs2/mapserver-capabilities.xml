  <ows:OperationsMetadata>
    <ows:Operation name="GetCapabilities">
      <ows:DCP>
        <ows:HTTP>
          <ows:Get xlink:type="simple" xlink:href="https://demo.mapserver.org/cgi-bin/wcs?"/>
          <ows:Post xlink:type="simple" xlink:href="https://demo.mapserver.org/cgi-bin/wcs?">
            <ows:Constraint name="PostEncoding">
              <ows:AllowedValues>
                <ows:Value>XML</ows:Value>
              </ows:AllowedValues>
            </ows:Constraint>
          </ows:Post>
        </ows:HTTP>
      </ows:DCP>
    </ows:Operation>
    <ows:Operation name="DescribeCoverage">
      <ows:DCP>
        <ows:HTTP>
          <ows:Get xlink:type="simple" xlink:href="https://demo.mapserver.org/cgi-bin/wcs?"/>
          <ows:Post xlink:type="simple" xlink:href="https://demo.mapserver.org/cgi-bin/wcs?">
            <ows:Constraint name="PostEncoding">
              <ows:AllowedValues>
                <ows:Value>XML</ows:Value>
              </ows:AllowedValues>
            </ows:Constraint>
          </ows:Post>
        </ows:HTTP>
      </ows:DCP>
    </ows:Operation>
    <ows:Operation name="GetCoverage">
      <ows:DCP>
        <ows:HTTP>
          <ows:Get xlink:type="simple" xlink:href="https://demo.mapserver.org/cgi-bin/wcs?"/>
