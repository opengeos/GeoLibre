{
  "manifest_version": 3,
  "name": "Open data in GeoLibre",
  "description": "Find geospatial datasets and services used by the current page and open them in GeoLibre.",
  "version": "0.4.0",
  "homepage_url": "https://geolibre.app/",
  "minimum_chrome_version": "106",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_title": "Open data in GeoLibre",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/geolibre-16.png",
      "32": "icons/geolibre-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/geolibre-16.png",
    "32": "icons/geolibre-32.png",
    "48": "icons/geolibre-48.png",
    "128": "icons/geolibre-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
