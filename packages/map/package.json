{
  "name": "@geolibre/map",
  "version": "3.0.0",
  "description": "Headless MapLibre layer synchronization and style engine from GeoLibre",
  "keywords": [
    "geolibre",
    "geospatial",
    "gis",
    "headless",
    "maplibre",
    "pmtiles"
  ],
  "homepage": "https://geolibre.app",
  "bugs": "https://github.com/opengeos/GeoLibre/issues",
  "license": "MIT",
  "author": "Qiusheng Wu",
  "repository": {
    "type": "git",
    "url": "https://github.com/opengeos/GeoLibre",
    "directory": "packages/map"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./headless": "./src/headless.ts",
    "./derived-geometry": "./src/derived-geometry.ts",
    "./pmtiles-layer": "./src/pmtiles-layer.ts",
    "./style-import": "./src/style-import.ts",
    "./style-layer-ids": "./src/style-layer-ids.ts",
    "./layer-labels": "./src/layer-labels.ts",
    "./map-capture": "./src/map-capture.ts",
    "./arcgis-sdk": "./src/arcgis-sdk.ts",
    "./zarr-source": "./src/zarr-source.ts",
    "./kerchunk-reference-store": "./src/kerchunk-reference-store.ts",
    "./arcgis-control-adapters": "./src/arcgis-control-adapters.ts"
  },
  "publishConfig": {
    "main": "./dist/headless.mjs",
    "types": "./dist/headless.d.mts",
    "exports": {
      ".": {
        "types": "./dist/headless.d.mts",
        "import": "./dist/headless.mjs"
      },
      "./headless": {
        "types": "./dist/headless.d.mts",
        "import": "./dist/headless.mjs"
      },
      "./derived-geometry": {
        "types": "./dist/derived-geometry.d.mts",
        "import": "./dist/derived-geometry.mjs"
      },
      "./pmtiles-layer": {
        "types": "./dist/pmtiles-layer.d.mts",
        "import": "./dist/pmtiles-layer.mjs"
      },
      "./style-import": {
        "types": "./dist/style-import.d.mts",
        "import": "./dist/style-import.mjs"
      },
      "./style-layer-ids": {
        "types": "./dist/style-layer-ids.d.mts",
        "import": "./dist/style-layer-ids.mjs"
      },
      "./layer-labels": {
        "types": "./dist/layer-labels.d.mts",
        "import": "./dist/layer-labels.mjs"
      },
      "./map-capture": {
        "types": "./dist/map-capture.d.mts",
        "import": "./dist/map-capture.mjs"
      },
      "./arcgis-sdk": {
        "types": "./dist/arcgis-sdk.d.mts",
        "import": "./dist/arcgis-sdk.mjs"
      },
      "./zarr-source": {
        "types": "./dist/zarr-source.d.mts",
        "import": "./dist/zarr-source.mjs"
      },
      "./kerchunk-reference-store": {
        "types": "./dist/kerchunk-reference-store.d.mts",
        "import": "./dist/kerchunk-reference-store.mjs"
      },
      "./arcgis-control-adapters": {
        "types": "./dist/arcgis-control-adapters.d.mts",
        "import": "./dist/arcgis-control-adapters.mjs"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/headless.ts src/derived-geometry.ts src/pmtiles-layer.ts src/style-import.ts src/style-layer-ids.ts src/layer-labels.ts src/map-capture.ts src/arcgis-sdk.ts src/arcgis-control-adapters.ts src/zarr-source.ts src/kerchunk-reference-store.ts --format esm --dts"
  },
  "dependencies": {
    "@cesium/engine": "^26.3.0",
    "@cesium/widgets": "^16.2.0",
    "@geolibre/core": "*",
    "@maplibre/geojson-vt": "^6.1.1",
    "@maplibre/vt-pbf": "^4.3.2",
    "@protomaps/basemaps": "^5.7.2",
    "@turf/bbox": "^7.4.0",
    "@turf/bbox-polygon": "^7.4.0",
    "@turf/boolean-intersects": "^7.4.0",
    "@turf/buffer": "^7.4.0",
    "@turf/centroid": "^7.4.0",
    "@turf/convex": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/mask": "^7.4.0",
    "cesium": "^1.145.0",
    "cog-tiler-wasm": "^0.3.5",
    "copc": "^0.0.9",
    "fast-xml-parser": "^5.11.1",
    "geotiff": "^3.0.5",
    "geotiff-geokeys-to-proj4": "^2024.4.13",
    "laz-perf": "^0.0.7",
    "mapbox-gl": "^3.31.0",
    "maplibre-gl": "^6.10.0",
    "maplibre-gl-layer-control": "^0.17.4",
    "pmtiles": "^4.5.0",
    "proj4": "^2.22.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "satellite.js": "^7.1.0",
    "zarrita": "^0.7.5"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
