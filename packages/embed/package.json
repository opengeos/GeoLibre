{
  "name": "@geolibre/embed",
  "version": "2.9.0",
  "description": "Typed client for GeoLibre's iframe embed API",
  "keywords": [
    "embed",
    "geolibre",
    "gis",
    "iframe",
    "map",
    "maplibre",
    "postmessage"
  ],
  "homepage": "https://geolibre.app/user-guide/embedding/",
  "bugs": "https://github.com/opengeos/GeoLibre/issues",
  "license": "MIT",
  "author": "Qiusheng Wu",
  "repository": {
    "type": "git",
    "url": "https://github.com/opengeos/GeoLibre",
    "directory": "packages/embed"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
